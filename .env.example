# Pooled connection — used by the app at runtime.
# On Neon this is the host containing "-pooler". Prisma needs the two query
# params: PgBouncer runs in transaction mode, and each serverless function
# instance must hold at most one connection.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/rccp?sslmode=require&pgbouncer=true&connection_limit=1"

# Unpooled connection — used ONLY by `prisma migrate`. Same host without
# "-pooler". Migrations take advisory locks that PgBouncer cannot proxy.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/rccp?sslmode=require"

# 32 characters minimum. The app refuses to start below that rather than
# signing sessions with a weak key.
JWT_SECRET="generate-with-openssl-rand-base64-32"

NEXT_PUBLIC_BASE_URL="https://your-app.vercel.app"
